# Copie para .env (nunca commitado — ver .gitignore) e preencha.
# Isso configura o VAULT em si (Infisical), não os segredos do projeto —
# os segredos reais (OIDC_CLIENT_SECRET etc.) são colados na UI do Infisical
# depois que ele estiver de pé, não aqui. Ver SPEC-12.

# Banco interno do Infisical (não é o `db` do projeto principal).
POSTGRES_USER=infisical
POSTGRES_PASSWORD=troque_isto
POSTGRES_DB=infisical

# Senha do Redis interno do Infisical.
REDIS_PASSWORD=troque_isto_tambem

# Gerar com: openssl rand -hex 16
ENCRYPTION_KEY=

# Gerar com: openssl rand -base64 32
AUTH_SECRET=

# URL pela qual você (humano) acessa a UI do Infisical no navegador.
# 8081, não 8080 — 8080 já é o frontend do gerador-de-itens (docker-compose.yml
# na raiz do projeto).
SITE_URL=http://localhost:8081
