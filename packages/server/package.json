    "@gerador/aplicacao": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "eslint": "^9.14.0",
    "@typescript-eslint/parser": "^8.13.0",
