{
  "name": "gerador",
  "private": true,
  "version": "0.1.0",
  "author": "Silvio Allgayer Trindade <silvioaltr@gmail.com> (https://github.com/silvioAL)",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/engine",
    "packages/llm",
    "packages/aplicacao",
    "packages/web",
    "packages/server",
    "packages/gateway-falso"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e": "npm run e2e:up && npm run test:e2e -w packages/web; npm run e2e:down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "node-llama-cpp@3.19.1": true
  }
}
