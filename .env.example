# Copie para .env (nunca commitado — ver .gitignore). Só é lido quando você
# sobe a stack de PRODUÇÃO com o overlay de segredos (docker-compose.secrets.yml,
# ver SPEC-12):
#
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d --build
#
# Em dev/E2E normal (`docker compose up`, AUTH_MODE=dev), nada disto é
# necessário — o server nem tenta ler estas variáveis.

# URL pública de callback do OAuth (não é segredo, mas muda por deploy).
OIDC_REDIRECT_URI=https://seu-dominio/auth/callback

# Machine Identity criada na UI do Infisical (infra/secrets/), escopada só
# pra ler o projeto/ambiente deste app — ver SPEC-12 §5.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
